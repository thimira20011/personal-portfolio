  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lime action with dark text and immediate press feedback.",
      "html": "<button class=\"ds-primary\" type=\"button\">View resume</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:52px;padding:14px 22px;border-radius:8px;font:700 14px var(--body,Manrope,sans-serif);cursor:pointer;transition:transform 160ms var(--ease-out,cubic-bezier(.23,1,.32,1)),background-color 160ms ease,color 160ms ease;border:1px solid transparent;background:var(--action,#c4f464);color:var(--on-action,#20251a);}.ds-primary:focus-visible{outline:3px solid var(--accent,#426015);outline-offset:4px;}.ds-primary:active{transform:scale(.97);}@media(hover:hover) and (pointer:fine){.ds-primary:hover{transform:translateY(-1px);background:color-mix(in srgb,var(--action,#c4f464),var(--ink,#23231e) 12%);}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary{transform:none!important;transition-property:color,background-color,border-color;transition-duration:120ms;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Surface-colored action with a theme divider.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Explore my work</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:52px;padding:14px 22px;border-radius:8px;font:700 14px var(--body,Manrope,sans-serif);cursor:pointer;transition:transform 160ms var(--ease-out,cubic-bezier(.23,1,.32,1)),background-color 160ms ease,color 160ms ease;border:1px solid var(--line,#c7b9a3);background:var(--surface,#f5eee3);color:var(--ink,#23231e);}.ds-secondary:focus-visible{outline:3px solid var(--accent,#426015);outline-offset:4px;}.ds-secondary:active{transform:scale(.97);}@media(hover:hover) and (pointer:fine){.ds-secondary:hover{transform:translateY(-1px);background:var(--accent-soft,#e0e8c9);color:var(--accent,#426015);}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary{transform:none!important;transition-property:color,background-color,border-color;transition-duration:120ms;}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Readable 16px field on the page surface.",
      "html": "<label class=\"ds-label\" for=\"ds-contact-name\">Name</label><input class=\"ds-input\" id=\"ds-contact-name\" placeholder=\"Your name\">",
      "css": ".ds-label{display:block;margin-bottom:8px;color:var(--ink,#23231e);font:600 13px var(--body,Manrope,sans-serif);}.ds-input{width:100%;padding:12px 14px;border:1px solid var(--line,#c7b9a3);border-radius:8px;background:var(--page,#ece4d6);color:var(--ink,#23231e);font:16px var(--body,Manrope,sans-serif);caret-color:var(--accent,#426015);transition:border-color 160ms ease;}.ds-input::placeholder{color:var(--muted,#595346);opacity:1;}.ds-input:hover{border-color:var(--accent,#426015);}.ds-input:focus-visible{outline:3px solid var(--accent,#426015);outline-offset:4px;}.ds-input:disabled{opacity:.5;}"
    },
    {
